# Copiar a .env y completar. El .env NO se commitea.

NODE_ENV=production

# --- Base de datos propia de yard (contenedor db_yard) ---
DB_NAME=yard
DB_USER=yard
DB_PASSWORD=cambiar
DB_ROOT_PASSWORD=cambiar

# --- Integracion con ttfa-docker ---
# Endpoint interno de ttfa que valida la cookie JWT. Es el mismo que usa
# nginx via auth_request; el backend lo consulta para saber QUIEN es el usuario
# (auth_request solo responde si pasa o no, no devuelve el email).
TTFA_VERIFY_URL=http://ttfa-backend:3000/api/login/verify

# --- Solo desarrollo ---
# En dev no hay nginx delante, asi que no llega cookie. Con esto se simula
# el usuario logueado. Ignorado cuando NODE_ENV=production.
DEV_USER_EMAIL=tpozo@ttfasa.com

# --- Fotos ---
# Lado mayor al que se redimensiona en el servidor y calidad JPEG.
# El celular ademas comprime antes de encolar (ver public/js/camera.js).
FOTO_MAX_LADO=1600
FOTO_CALIDAD=80
